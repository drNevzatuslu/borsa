# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env dosyası git'e girmez.
# ZORUNLU
ANTHROPIC_API_KEY=

# İSTEĞE BAĞLI (boş bırakılırsa ilgili veri kaynağı atlanır)
TCMB_EVDS_API_KEY=        # TCMB EVDS: faiz, enflasyon, kur, rezerv  (evds2.tcmb.gov.tr)
FRED_API_KEY=             # ABD makro verileri (fred.stlouisfed.org)
FINNHUB_API_KEY=          # ABD/global şirket haberleri, piyasa haberleri (finnhub.io, ücretsiz katman)
NEWSAPI_KEY=              # Haber başlıkları (newsapi.org)
X_BEARER_TOKEN=           # X/Twitter API v2 son tweet araması (developer.x.com)
REDDIT_CLIENT_ID=         # Reddit API (reddit.com/prefs/apps)
REDDIT_CLIENT_SECRET=
SEC_USER_AGENT=           # SEC EDGAR için zorunlu kimlik: "Ad Soyad eposta@ornek.com"
